#!/bin/sh
set -e

. /usr/lib/smhub/service-helpers.sh

PKG_NAME="connecta-m-hi"
SERVICE_NAME="dom.oti.cat"


pkg_service_remove "${PKG_NAME}" "${SERVICE_NAME}" "$1"

# On full removal only (opkg passes "remove"; on an upgrade it passes "upgrade", so the bridge
# survives IPK updates), tear down the config we own: drop the service from the default runlevel
# and remove the mosquitto bridge config so mosquitto returns to local-only mode.
# (SMLIGHT asked for this cleanup on uninstall; we use postrm+remove rather than prerm because
# prerm also runs on upgrades on this opkg, which would drop the bridge on every update.)
if [ "$1" = "remove" ]; then
    echo "[oticonnect] postrm remove: cleaning up owned config"
    if [ -f /etc/mosquitto/conf.d/oti-bridge.conf ] || [ -f /etc/mosquitto/conf.d/oti-passwd ]; then
        rm -f /etc/mosquitto/conf.d/oti-bridge.conf /etc/mosquitto/conf.d/oti-passwd
        rc-service mosquitto restart 2>/dev/null || true
        echo "[oticonnect] postrm remove: removed mosquitto bridge config"
    fi
fi

exit 0
